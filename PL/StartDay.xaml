<Window x:Class="PL.StartDay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="StartDay" Height="170" Width="350">
    <Window.Resources>        <Style x:Key="myLabelStyle" TargetType="Label" >            <Setter Property="FontSize"            Value="13" />            <Setter Property="FontFamily"            Value="Aharoni" />            <Setter Property="FontWeight"            Value="Bold"/>            <Setter Property="Foreground" Value="#FF673AB7" />

        </Style>    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>


        </Grid.ColumnDefinitions>

        <Label Content="Select start day of the project:" HorizontalAlignment="Center" VerticalAlignment="Top" Height="36" Width="200" Grid.Column="1" Grid.Row="1" Style="{StaticResource myLabelStyle}" />

        <DatePicker
    HorizontalAlignment="Center"
    Height="32"
    Width="206"
    SelectedDate="{Binding StartDate, Mode=TwoWay}"
    Visibility="{Binding StartProject, Converter={StaticResource ConvertDateStatusToVisibilityKey}}"
    IsEnabled="{Binding StartProject, Mode=OneTime, Converter={StaticResource ConvertDateToContentKey}}"
    SelectedDateChanged="DatePicker_SelectedDateChanged" Grid.Column="1" Grid.Row="2"/>

    </Grid>
</Window>
