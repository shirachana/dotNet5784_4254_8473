<Window x:Class="PL.EngineerViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="EngineerViewWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Button to add a task to an employee -->
        <Button Content="Add Task to Engineer" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Click="BtnAddTask_Click" Height="60"/>

        <!-- Button to update the user -->
        <Button Content="Update User" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="60" Click="BtnUppUse_Click"/>

        <!-- Button for current task -->
        <Button Content="Current Task" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200"  Height="60" Click="BtnCurrent_Click"/>

        <!-- Button to exit -->
        <Button Content="Log Out" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200"  Height="60" Click="BtnExit_Click"/>
    </Grid>
</Window>

