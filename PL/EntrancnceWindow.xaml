<Window x:Class="PL.EntrancnceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="EntrancnceWindow" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width= "*"/>
            <ColumnDefinition Width= "*"/>
            <ColumnDefinition Width= "*"/>
            <ColumnDefinition Width= "*"/>
        </Grid.ColumnDefinitions>
        <Label Content= "User Name" HorizontalAlignment="Center" Width="150" Grid.Column="1" Grid.Row="1"  />
        <Label Content= "Code" HorizontalAlignment="Center" Width="150"  Grid.Column="1" Grid.Row="2" />
        <TextBox x:Name="UserName" Text="{Binding UserName, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" HorizontalAlignment="Center" Grid.Column="2" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="150" Height="67"/>
        <TextBox x:Name="Code" Text="{Binding Code, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" HorizontalAlignment="Center" Grid.Column="2" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Width="150" Height="66"/>

        <Button Grid.Column="1" Content="Log In" HorizontalAlignment="Center"  Grid.Row="3" VerticalAlignment="Center" Height="67" Width="150" Click="BtnLogIn_Click"/>
    </Grid>
</Window>
