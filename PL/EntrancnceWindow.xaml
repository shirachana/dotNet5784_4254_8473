<Window x:Class="PL.User.EntrancnceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="EntrancnceWindow" Height="600" Width="800">
    <Window.Resources>        <Style x:Key="myLabelStyle" TargetType="Label" >            <Setter Property="FontSize"         Value="10" />            <Setter Property="FontWeight"         Value="Bold"/>

        </Style>        <Style x:Key="eventTrigger" TargetType="Button">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF673AB7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <LinearGradientBrush x:Key="myLinearGradientBrush">            <GradientStop Color="#FF673AB7"/>        </LinearGradientBrush>

        <Style x:Key="myTextBStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.300" Storyboard.TargetProperty="FontSize" To="23" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.800" Storyboard.TargetProperty="FontSize" To="18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>



    </Window.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="User Name" HorizontalAlignment="Center" Width="86" Height="50" Style="{StaticResource myLabelStyle}"  Grid.Row="1" Grid.Column="1" />
        <TextBox Text="{Binding NameUser, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" BorderBrush="Black"  Grid.Row="2" Height="30" VerticalAlignment="Top" />

        <!-- Password label and PasswordBox -->
        <Label Content="Password" HorizontalAlignment="Center"  Grid.Column="1"  Grid.Row="3"  Style="{StaticResource myLabelStyle}" />
        <PasswordBox DataContext="{Binding CodeUser, UpdateSourceTrigger=PropertyChanged}"  PasswordChanged="PasswordBox_PasswordChanged" Grid.Column="1" Grid.Row="4" Grid.RowSpan="3" />


        <!-- Login button -->
        <Button Content="Log In" Background="{StaticResource myLinearGradientBrush}"  HorizontalAlignment="Left"  Grid.Row="3"  Grid.Column="3" Width="120" Height="50" Click="BtnLogIn_Click"  Style="{StaticResource eventTrigger}" />

        <!-- Sign-in button -->
        <Button Content="Sign In" Background="{StaticResource myLinearGradientBrush}" HorizontalAlignment="Left" Grid.Row="2" Click="BtnSignIn_Click" Grid.Column="3" Width="120"  Height="50" Style="{StaticResource eventTrigger}" />


        <!-- Current time label -->
        <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm:ss dd/MM/yyyy}}"  Grid.Row="5"  Style="{StaticResource myTextBStyle}" Grid.Column="0" Grid.ColumnSpan="2"    >
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>



        <!-- StackPanel for time manipulation buttons -->

        <StackPanel VerticalAlignment="Top" Orientation="Horizontal"  Grid.Row="5" Height="59"  Grid.Column="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Width="504" Grid.RowSpan="2" >

            <!-- Buttons to advance time -->
            <!-- Buttons to advance time -->

            <Button Content="Advance Hour" Click="BtnAdvanceHour_Click" Width="125"  Height="37" Grid.Column="2" Grid.Row="3"    />
            <Button Content="Advance Day" Click="BtnAdvanceDay_Click"  HorizontalAlignment="Center" Grid.Column="2" Grid.Row="3" Width="125"  Height="37"   />
            <Button Content="Advance Year" Click="BtnAdvanceYear_Click" Width="125" Height="37"  />
            <Button Content="Reset" Click="BtnReset_Click" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="41" Width="125"  Height="37" />
        </StackPanel>

    </Grid>
</Window>

