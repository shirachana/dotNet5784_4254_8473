<Window x:Class="PL.EntrancnceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="EntrancnceWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width= "*"/>
        </Grid.ColumnDefinitions>
        <Button Content="Manager" HorizontalAlignment="Center" Grid.Column="1"  Grid.Row="4"  VerticalAlignment="Top" Height="124" Width="400" Margin="0,62,0,0" Grid.RowSpan="3" Click="GoToManagerViewButton_Click"/>
        <Button Content="Engineer" HorizontalAlignment="Center"  Grid.Row="4" VerticalAlignment="Top" Height="124" Width="400" Margin="0,62,0,0" Grid.RowSpan="3" Click="GoToEngineerViewButton_Click"/>
        <!--<TextBlock x:Name="TimeDisplayLabel"  Grid.Column="1"  Grid.Row="2" Text="{Binding CurrentTime}"   FontSize="18" HorizontalAlignment="Center" Margin="0,62,0,0" Grid.RowSpan="2" Width="400"/>-->
        <!-- Advance Hour Button -->
        <Button Grid.Row="1" Content="Advance Hour" Click="AdvanceHourButton_Click" HorizontalAlignment="Center" Margin="0 10"/>

        <!-- Advance Day Button -->
        <Button Grid.Row="2" Content="Advance Day" Click="AdvanceDayButton_Click" HorizontalAlignment="Center"/>
    </Grid>
</Window>
