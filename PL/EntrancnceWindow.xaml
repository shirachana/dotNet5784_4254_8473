<Window x:Class="PL.User.EntrancnceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="EntrancnceWindow" Height="600" Width="800">
    <Window.Resources>        <Style x:Key="myLabelStyle" TargetType="Label" >            <Setter Property="FontSize"         Value="10" />            <Setter Property="FontWeight"         Value="Bold"/>

        </Style>        <Style x:Key="eventTrigger" TargetType="Button">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF673AB7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <LinearGradientBrush x:Key="myLinearGradientBrush">            <GradientStop Color="#FF673AB7"/>        </LinearGradientBrush>

        <Style x:Key="myTextBStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.300" Storyboard.TargetProperty="FontSize" To="23" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Duration="0:0:0.800" Storyboard.TargetProperty="FontSize" To="18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>



    </Window.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="User Name" HorizontalAlignment="Center" Width="86" Margin="0,65,0,97" Grid.Column="1"  Style="{StaticResource myLabelStyle}" />
        <TextBox Text="{Binding NameUser, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="10,129,8,26" BorderBrush="Black" BorderThickness="0,0,0,1"/>

        <!-- Password label and PasswordBox -->
        <Label Content="Password" HorizontalAlignment="Left" Width="77" Grid.Column="1" Margin="46,71,0,62" Grid.Row="1"  Style="{StaticResource myLabelStyle}" />
        <PasswordBox DataContext="{Binding CodeUser, UpdateSourceTrigger=PropertyChanged}" PasswordChanged="PasswordBox_PasswordChanged" Grid.Row="1" Grid.Column="1" Margin="10,132,10,13"/>


        <!-- Login button -->
        <Button Content="Log In" Background="{StaticResource myLinearGradientBrush}"  HorizontalAlignment="Left" Grid.Column="3" Width="120" Height="50" Click="BtnLogIn_Click" Margin="0,137,0,10" Style="{StaticResource eventTrigger}"/>

        <!-- Sign-in button -->
        <Button Content="Sign In" Background="{StaticResource myLinearGradientBrush}" HorizontalAlignment="Right" Grid.Row="1" Click="BtnSignIn_Click" Margin="0,112,40,32" Grid.Column="3" Width="120"  Height="50" Style="{StaticResource eventTrigger}"/>


        <!-- Current time label -->
        <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm:ss dd/MM/yyyy}}" Grid.ColumnSpan="2" Margin="13,124,47,19" Grid.Row="2"  Style="{StaticResource myTextBStyle}" RenderTransformOrigin="0.5,0.5"   >
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>



        <!-- StackPanel for time manipulation buttons -->

        <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Grid.Row="2" Height="59" Margin="0,112,9,0" RenderTransformOrigin="0.533,0.574" Grid.Column="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Width="504">

            <!-- Buttons to advance time -->
            <!-- Buttons to advance time -->

            <Button Content="Advance Hour" Click="BtnAdvanceHour_Click" Width="125"  Height="37"   />
            <Button Content="Advance Day" Click="BtnAdvanceDay_Click"  HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" Width="125"  Height="37"   />
            <Button Content="Advance Year" Click="BtnAdvanceYear_Click" Width="125" Height="37"  />
            <Button Content="Reset" Click="BtnReset_Click" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="41" Width="125"  Height="37" />
        </StackPanel>

    </Grid>
</Window>

