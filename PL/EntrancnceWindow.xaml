<Window x:Class="PL.EntrancnceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding User, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
        Title="EntrancnceWindow" Height="700" Width="800">
    <Grid >
        <Grid.RowDefinitions>
            <!-- Define your row definitions here -->
            <RowDefinition Height="*"/>
            <!-- Row for username label -->
            <RowDefinition Height="*"/>
            <!-- Row for password label -->
            <RowDefinition Height="*"/>
            <!-- Row for username textbox -->
            <RowDefinition Height="*"/>
            <!-- Row for password textbox -->
            <RowDefinition Height="*"/>
            <!-- Row for login button -->
            <RowDefinition Height="*"/>
            <!-- Row for current time label -->
            <RowDefinition Height="*"/>
            <!-- Row for time manipulation buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Define your column definitions here -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Username label -->
        <Label Content="User Name" HorizontalAlignment="Center" Width="98" Grid.Row="0" Margin="0,10,0,58" Grid.Column="2"/>
        <!-- Password label -->
        <Label Content="Password" HorizontalAlignment="Left" Width="77" Grid.Column="2" Margin="17,14,0,48" Grid.Row="1"/>

        <!-- Username textbox -->
        <TextBox Text="{Binding User, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" HorizontalAlignment="Center" Grid.Column="2" Grid.Row="0" Width="110" Margin="0,30,0,27"/>
        <!-- Password textbox -->
        <PasswordBox DataContext="{Binding User.Password, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" 
             HorizontalAlignment="Center" 
             Grid.Column="2" 
             Width="110" 
             Margin="0,49,0,10" 
             Grid.Row="1"/>
        <!-- Login button -->
        <Button Content="Log In" HorizontalAlignment="Left" Grid.Column="3" Width="79" Click="BtnLogIn_Click" Margin="92,39,0,27" Grid.ColumnSpan="2"/>
        <!-- Message label -->
        <Label Content="Don't have an account?" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="76,10,0,57" Grid.Column="3" Grid.Row="1" Width="141"/>

        <!-- Sign-in button -->
        <Button Content="Sign In" HorizontalAlignment="Left" Grid.Row="1" Grid.ColumnSpan="2" Click="BtnSignIn_Click" Margin="95,45,0,20" Grid.Column="3"/>


        <!-- Current time label -->
        <!--
        <Label Content="{Binding CurrentTime, StringFormat='Current Time: {0:HH:mm:ss}'}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="133,24,0,0" Grid.Row="2" Height="141" Width="534" Grid.ColumnSpan="6" Grid.RowSpan="2"/>

        -->
        <!-- StackPanel for time manipulation buttons -->
        <!--
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Grid.Row="3" Height="195" Width="624" Grid.ColumnSpan="6" Margin="88,88,0,0" Grid.RowSpan="3">
            -->
        <!-- Buttons to advance time -->
        <!-- Buttons to advance time -->
        <!--
            <Button Content="Advance Hour" Click="BtnAdvanceHour_Click" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Width="150"  Height="37"   />
            <Button Content="Advance Day" Click="BtnAdvanceDay_Click"  HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2" Width="150"  Height="37"   />
            <Button Content="Advance Year" Click="BtnAdvanceYear_Click" Width="150" Height="37"  />
            <Button Content="Reset" Click="BtnReset_Click" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="41" Width="150"  Height="37" />
        </StackPanel>-->
    </Grid>
</Window>

