<Window x:Class="PL.GantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="GantWindow" Height="450" Width="1800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
    <Window.Resources>
        <local:TaskColorConverter x:Key="TaskColorConverterKey"/>
        <local:TaskWidthConverter x:Key="TaskWidthConverterKey"/>
        <!-- Define colors for completed and incomplete tasks -->
        <SolidColorBrush x:Key="CompletedTaskColor" Color="Green"/>
        <SolidColorBrush x:Key="IncompleteTaskColor" Color="Blue"/>
        <SolidColorBrush x:Key="DelayedTaskColor" Color="Red"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ListView for detailed task view -->
        <ListView ItemsSource="{Binding TaskOfList}" HorizontalContentAlignment="Stretch" Grid.Row="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="100"/>
                    <GridViewColumn Header="Alias" DisplayMemberBinding="{Binding Alias}" Width="100"/>
                    <GridViewColumn Header="Dependencies">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Dependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Additional columns can be added here if needed -->
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ListBox for Gantt chart view -->
        <ListBox ItemsSource="{Binding TaskOfList}" HorizontalContentAlignment="Stretch" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StartDate}" Margin="5"/>
                        <Border BorderBrush="Black" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StartDate}" Margin="5"/>
                                <Rectangle Grid.Column="1" 
                                           Width="{Binding Converter={StaticResource TaskWidthConverterKey}}"
                                           Height="20"
                                           Fill="{Binding Converter={StaticResource TaskColorConverterKey}}" />
                                <TextBlock Grid.Column="2" Text="{Binding RemainingTime}" Margin="5"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Legend -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Row="2">
            <TextBlock Text="Legend: " Margin="5"/>
            <Border Background="Green" Width="20" Height="20" Margin="5"/>
            <TextBlock Text="Completed" Margin="0,5,5,5"/>
            <Border Background="Blue" Width="20" Height="20" Margin="5"/>
            <TextBlock Text="Incomplete" Margin="0,5,5,5"/>
            <Border Background="Red" Width="20" Height="20" Margin="5"/>
            <TextBlock Text="Delayed" Margin="0,5,5,5"/>
        </StackPanel>
    </Grid>
</Window>
