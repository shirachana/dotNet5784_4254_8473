<Window x:Class="PL.GantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="GantWindow" Height="450" Width="800">
    <Grid>
        <ListBox ItemsSource="{Binding Tasks}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Border representing the task -->
                        <Border BorderBrush="Black" BorderThickness="1"
                                Width="{Binding RequiredEffortTime}" Height="30"
                                Margin="{Binding ScheduledDate, Converter={StaticResource DateToMarginConverterKey}}">
                            <!-- Textbox displaying the task ID -->
                            <TextBox Text="{Binding Id}" VerticalAlignment="Center"
                                     HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
