<Window x:Class="PL.GantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="GantWindow" Height="450" Width="1800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
    <Window.Resources>
        <local:TaskColorConverter x:Key="TaskColorConverterKey"/>
        <!-- Define colors for completed and incomplete tasks -->
            <SolidColorBrush x:Key="CompletedTaskColor" Color="Green"/>
        <SolidColorBrush x:Key="IncompleteTaskColor" Color="Blue"/>
        <SolidColorBrush x:Key="DelayedTaskColor" Color="Red"/>
    </Window.Resources>
    <Grid>
        <ListView ItemsSource="{Binding TaskOfList}" HorizontalContentAlignment="Stretch">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding TaskId}" Width="100"/>
                    <GridViewColumn Header="Alias" DisplayMemberBinding="{Binding TaskName}" Width="100"/>
                    <GridViewColumn Header="Dependencies">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Dependencies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Gantt Chart">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderBrush="White" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StartDate}"/>
                                        <Rectangle Grid.Column="1"
                               Width="{Binding DaysFromProjectStart}"
                               Height="20"
                               Fill="White"/>
                                        <!-- Dynamic Color Rectangle -->
                                        <Rectangle Grid.Column="2"
                               Width="{Binding TasksDays}"
                               Height="20"
                                                   Fill="HotPink"/>
                                        <!--Fill="{Binding Converter={StaticResource TaskColorConverterKey}}"/>-->

                                        <!-- White Rectangle 2 -->
                                        <Rectangle Grid.Column="3"
                               Width="{Binding DaysUntilProjectEnd}"
                               Height="20"
                               Fill="White" />
                                        <!--"{Binding Converter={StaticResource TaskWidthConverterKey}}"-->
                                                
                                        <!--"{Binding Converter={StaticResource TaskColorConverterKey}}" />-->
                                        <!-- You may add more details as needed -->
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <!-- Legend -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock Text="Legend: " Margin="5"/>
            <Border Background="Green" Width="20" Height="20" Margin="5"/>
            <TextBlock Text="Completed" Margin="0,5,5,5"/>
            <Border Background="Blue" Width="20" Height="20" Margin="5"/>
            <TextBlock Text="Incomplete" Margin="0,5,5,5"/>
            <Border Background="Red" Width="20" Height="20" Margin="5"/>
            <TextBlock Text="Delayed" Margin="0,5,5,5"/>
        </StackPanel>
    </Grid>
</Window>